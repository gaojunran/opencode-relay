{
  "name": "opencode-relay-plugin",
  "version": "0.2.3",
  "description": "opencode plugin: project workspaces via isolated git worktrees, with a guard that keeps the agent inside the project directory",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "config.example.toml"],
  "exports": {
    "./server": {
      "import": "./dist/relay.js",
      "types": "./dist/relay.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jclem/logfmt2": "^2.4.3",
    "@opencode-ai/plugin": "1.18.12"
  },
  "devDependencies": {
    "@types/node": "16.9.1",
    "typescript": "5.9.3"
  }
}
